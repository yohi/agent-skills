{
  "name": "browser-debug-buggy-app",
  "version": "1.0.0",
  "description": "Controlled buggy web application for browser-debug-agent integration evaluation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "fixture:reset": "node scripts/reset-fixture.js",
    "fixture:save-failure": "node scripts/save-failure.js",
    "fixture:post-login-blank": "node scripts/post-login-blank.js",
    "test": "npm run test:fixture",
    "test:fixture": "node --test test/fixture-health.test.js",
    "test:regression:settings": "node --test regression/settings-save.check.cjs",
    "test:regression:dashboard": "node --test regression/dashboard-render.check.cjs"
  },
  "dependencies": {
    "express": "^4.21.0"
  }
}
